# Configuration reference only. No application is implemented yet.
# Frontend: copy ONLY VITE_API_BASE_URL into frontend/.env.local.
# All VITE_* variables are public. Never prefix secrets with VITE_.
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Backend only: copy the settings below into a protected backend .env.
# Production must use the confirmed HTTPS origin and a persistent absolute DB path.
APP_ENV=development
CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
DATABASE_URL=sqlite+pysqlite:///./var/scamsense.db

# TODO: confirm provider, model, and endpoint. These placeholders are not usable.
MODEL_BASE_URL=https://model.example.invalid/v1
MODEL_NAME=TODO_MODEL_NAME
MODEL_API_KEY=REPLACE_WITH_LOCAL_SECRET_DO_NOT_COMMIT
MODEL_CONNECT_TIMEOUT_SECONDS=5
MODEL_FIRST_CHUNK_TIMEOUT_SECONDS=20
MODEL_TOTAL_TIMEOUT_SECONDS=90
MODEL_MAX_CONCURRENCY=2

# Proposed values; confirm privacy policy and runtime limits before implementation.
SESSION_TTL_HOURS=24
CLEANUP_INTERVAL_MINUTES=60
BACKUP_DIR=./var/backups
BACKUP_RETENTION_DAYS=7
